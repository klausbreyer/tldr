<!DOCTYPE html>
<html lang={@language} class="bg-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="tldr.tf">{assigns[:page_title]}</.live_title>
    <meta name="description" content={TldrWeb.Words.t(@language, :description)} />
    <%!-- The preview a shared link gets in chats and social posts. --%>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={TldrWeb.Words.t(@language, :tagline)} />
    <meta property="og:description" content={TldrWeb.Words.t(@language, :description)} />
    <meta property="og:image" content={url(~p"/images/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link
      rel="preload"
      href={~p"/fonts/InterTight-700-wordmark.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-bg text-text antialiased">
    {@inner_content}
  </body>
</html>
